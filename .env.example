OPENAI_API_KEY=

# GigaChat: ключ авторизации из кабинета developers.sber.ru, не коммитить.
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-3-Ultra
# При ошибке SSL (сертификат Минцифры) можно временно:
# GIGACHAT_VERIFY_SSL_CERTS=false

# Третий уровень RESULT/CONTROL для review-недель: GigaChat предлагает
# формулировку, решение остаётся за существующими гейтами. По умолчанию выключен;
# без GIGACHAT_CREDENTIALS ячейки просто остаются пустыми.
# CALENDAR_AI_REVIEW_FALLBACK=1
